# Local files that never reach the repository.
/CLAUDE.md
/.claude/

# Secrets and environment. The development server address (EXPO_PUBLIC_DEFAULT_SERVER) stays in
# the untracked `.env.local`.
.env
.env.*
!.env.example

# Dependencies and build output.
node_modules/
dist/
*.tsbuildinfo

# Expo's local state and the bundle `pnpm bundle:ios` writes to check the build.
.expo/
dist-check/
# Native projects: generated by `expo prebuild` from app.config.ts in the build workflow, never
# committed (docs/mobile-builds.md).
/ios
/android
# Generated into each target by @bacons/apple-targets from its expo-target.config.js (colours).
/targets/*/Assets.xcassets
