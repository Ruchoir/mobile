#!/bin/sh
#
# The forced command of the `deploy` account's Android key on the website's server: it can start
# android-publish with a version, and nothing else (sudoers allows exactly that).
#
# authorized_keys:
#   command="/usr/local/sbin/android-publish-entry",restrict ssh-ed25519 AAAA... ci-android
# /etc/sudoers.d/android-publish:
#   deploy ALL=(root) NOPASSWD: /usr/local/sbin/android-publish
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  *[!A-Za-z0-9.-]*|"") echo "expected a version, such as v1.2.3" >&2; exit 2 ;;
esac
exec sudo -n /usr/local/sbin/android-publish "$SSH_ORIGINAL_COMMAND"
